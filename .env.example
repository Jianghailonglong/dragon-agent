# Dragon Agent Environment Configuration
# Copy this file to .env and fill in your values.

# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Anthropic API base URL (required, e.g. for proxy or compatible endpoints)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model name (e.g. mimo-v2.5, claude-sonnet-4-20250514)
ANTHROPIC_MODEL=mimo-v2.5

# Optional: override config file path
# DRAGON_CONFIG=dragon.yaml

# Optional: Telegram bot token
# TELEGRAM_BOT_TOKEN=

# Optional: Feishu app credentials
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# Optional: WeChat webhook key
# WECHAT_WEBHOOK_KEY=
